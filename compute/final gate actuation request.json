{
  "$id": "https://example.local/schemas/gate-actuation.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GateActuationRequest",
  "type": "object",
  "required": ["transactionId", "memo", "operatorCredentialId", "companionCredentialId", "issuedAt", "signature"],
  "properties": {
    "transactionId": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "memo": { "$ref": "https://example.local/schemas/command-memo.json" },
    "operatorCredentialId": { "type": "string" },
    "companionCredentialId": { "type": "string" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "signature": { "type": "string", "description": "base64url-encoded signature by Gate Auth Service over entire payload" },
    "openDurationSec": { "type": "integer", "minimum": 1, "maximum": 3600 }
  },
  "additionalProperties": false
}
