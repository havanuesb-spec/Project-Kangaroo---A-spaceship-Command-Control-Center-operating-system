{
  "$id": "https://example.local/schemas/credential-record.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CredentialRecord",
  "type": "object",
  "required": ["credentialId", "userId", "publicKeyCose", "signCount", "attestationType", "enrolledAt"],
  "properties": {
    "credentialId": { "type": "string", "description": "base64url-encoded credential ID" },
    "userId": { "type": "string" },
    "publicKeyCose": { "type": "string", "description": "base64url-encoded COSE/CBOR public key or DER" },
    "signCount": { "type": "integer", "minimum": 0 },
    "attestationType": { "type": "string" },
    "authenticatorModel": { "type": "string" },
    "enrolledAt": { "type": "string", "format": "date-time" },
    "revoked": { "type": "boolean", "default": false },
    "revokedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
