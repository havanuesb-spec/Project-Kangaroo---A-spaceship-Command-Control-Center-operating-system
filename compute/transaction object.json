{
  "$id": "https://example.local/schemas/transaction.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GateTransaction",
  "type": "object",
  "required": ["transactionId", "challengeOperator", "challengeCompanion", "rpId", "issuedAt", "expiresAt"],
  "properties": {
    "transactionId": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$",
      "description": "256-bit hex transaction identifier"
    },
    "challengeOperator": {
      "type": "string",
      "description": "Base64url-encoded challenge for operator (WebAuthn challenge)"
    },
    "challengeCompanion": {
      "type": "string",
      "description": "Base64url-encoded challenge for companion (WebAuthn challenge)"
    },
    "rpId": {
      "type": "string",
      "description": "Relying Party ID (e.g., host name)"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "allowedActions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "context": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional contextual metadata (geo, device posture markers, initiator IP hash)"
    }
  },
  "additionalProperties": false
}
